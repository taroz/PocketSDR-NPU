#
#  makefile for Pocket SDR accelerator backend plugin for Axera NPU
#  (libsdr_acc_axcl.so loaded by sdr_acc_init("axcl") at runtime)
#
#! Install AXCL (axcl_host driver and runtime, e.g. package axclhost) and FFTW3
#! (libfftw3f) and set AXCL_DIR if not in /usr. Place the axmodels generated by
#! gen_axcl_acq.py in ../linux/axcl.

SRC = ../../src
AXCL_DIR ?= /usr

CXX = g++
INSTALL = ../linux
CXXFLAGS = -O3 -std=c++17 -fPIC -Wall -g -mcpu=native -I$(SRC) \
    -I$(AXCL_DIR)/include/axcl
LDLIBS = -L$(AXCL_DIR)/lib/axcl -laxcl_rt -lfftw3f -lpthread -ldl \
    -Wl,-rpath,$(AXCL_DIR)/lib/axcl

TARGET = libsdr_acc_axcl.so

all : $(TARGET)

libsdr_acc_axcl.so: sdr_acc_axcl.o
	$(CXX) -shared -o $@ $< $(LDLIBS)
sdr_acc_axcl.o : $(SRC)/sdr_acc_axcl.cpp $(SRC)/sdr_acc.h
	$(CXX) -c $(CXXFLAGS) $<

clean:
	rm -f $(TARGET) sdr_acc_axcl.o

install:
	cp $(TARGET) $(INSTALL)

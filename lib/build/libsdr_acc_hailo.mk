#
#  makefile for Pocket SDR accelerator backend plugin for Hailo NPU
#  (libsdr_acc_hailo.so loaded by sdr_acc_init("hailo") at runtime)
#
#! Install HailoRT (libhailort.so, hailo/hailort.hpp, e.g. package hailort and
#! hailort-pcie-driver) and set HAILO_DIR if not in /usr. Place the HEFs
#! generated by gen_hailo_acq.py in ../linux/hailo.

SRC = ../../src
HAILO_DIR ?= /usr

CXX = g++
INSTALL = ../linux
CXXFLAGS = -O3 -std=c++17 -fPIC -Wall -g -mcpu=native -I$(SRC) \
    -I$(HAILO_DIR)/include
LDLIBS = -L$(HAILO_DIR)/lib -lhailort -lpthread -ldl

TARGET = libsdr_acc_hailo.so

all : $(TARGET)

libsdr_acc_hailo.so: sdr_acc_hailo.o
	$(CXX) -shared -o $@ $< $(LDLIBS)
sdr_acc_hailo.o : $(SRC)/sdr_acc_hailo.cpp $(SRC)/sdr_acc.h
	$(CXX) -c $(CXXFLAGS) $<

clean:
	rm -f $(TARGET) sdr_acc_hailo.o

install:
	cp $(TARGET) $(INSTALL)
